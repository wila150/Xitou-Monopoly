# Postgres 連線字串（本機開發可用 postgres://localhost/line_checkpoint_dev）
# 部署到 Render 時，去 Render 的 Postgres 服務頁籤複製 "Internal Database URL" 貼在這裡
DATABASE_URL=postgres://user:password@host:5432/dbname

# 本機連線 Postgres 通常不需要 SSL，設 false 關閉；Render 內部連線則不用設這個（預設會開 SSL）
PGSSL=false

# LINE Developers Console -> Messaging API 頁籤
LINE_CHANNEL_ACCESS_TOKEN=請貼上你的 Channel access token
LINE_CHANNEL_SECRET=請貼上你的 Channel secret

# 系統管理員（小編）的 LINE userId，多人以逗號分隔，什麼管理指令都能用
# 取得方式：讓該帳號傳任意訊息給官方帳號，於 server log 印出的 userId 複製貼上
ADMIN_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 現場關主不需要在這裡設定：他們自己在 LINE 傳「我是 B3 關主」（換成自己負責的代號）
# 就會自動登記到資料庫，之後只能核准自己登記的那一關，不需要小編手動維護名單

# 伺服器對外可存取的網址（用於組出關卡地圖圖片的網址，須為 https）
# 本機測試可用 ngrok/cloudflared 提供的網址
PUBLIC_BASE_URL=https://your-public-domain.example.com

# 後台網頁（/admin）的共用登入密碼，交給要編輯關卡/路線的小編就好，不要外流
ADMIN_PANEL_PASSWORD=請設定一個後台密碼

# 後台網頁登入 cookie 的簽名密鑰，隨便打一段長亂碼即可（跟 ADMIN_PANEL_PASSWORD 不同用途，不要共用同一個字串）
ADMIN_PANEL_SECRET=請設定一段隨機字串

# 伺服器監聽埠
PORT=3000

# 活動時區（影響 12:15 提醒與 12:30 自動結算的觸發時間）
TZ=Asia/Taipei

# （選填）緊急聯絡的回覆訊息會附上這支電話，建議填現場總召或小編的手機
EMERGENCY_PHONE=
